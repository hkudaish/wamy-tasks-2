# ============================================================
#  نظام إدارة ومتابعة المهام — وامي | ملف الإعدادات
#  انسخ هذا الملف إلى .env واملأ القيم. لا تُدرج .env في Git.
# ============================================================

# --- قاعدة البيانات ---
DATABASE_URL=postgresql://wamy:CHANGE_ME@localhost:5432/wamy_tasks
PG_SSL=false
PG_POOL_MAX=10

# --- الخادم ---
PORT=3000
# ضع خلف عاكس (Nginx) واضبط عدد الطبقات
TRUST_PROXY=1
# رابط النظام كما يصل إليه المستخدم (يظهر في رسائل البريد)
APP_URL=https://tasks.wamy.org

# --- الأمان (إلزامي) ---
# أنشئ المفتاح بالأمر:  openssl rand -hex 32
SESSION_SECRET=
# اجعلها true عند التشغيل على HTTPS (إلزامي في الإنتاج)
COOKIE_SECURE=true
# قفل مؤقت بعد عدد المحاولات الفاشلة خلال النافذة الزمنية
LOCK_MAX_FAILS=5
LOCK_WINDOW_MIN=15

# --- حساب مدير النظام الأول (يُستخدم عند التهيئة فقط) ---
ADMIN_NAME=مدير النظام
ADMIN_EMAIL=admin@wamy.org
ADMIN_PASSWORD=
ALLOWED_DOMAIN=wamy.org

# --- المرفقات ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# --- البريد الإلكتروني (اختياري: اتركه فارغًا لتعطيل البريد) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="نظام إدارة المهام - وامي" <no-reply@wamy.org>

# --- SMS وواتساب (اختياري: Webhook لدى مزود الخدمة) ---
# يستقبل JSON: {to,message,kind,taskId,recipient}
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
WHATSAPP_WEBHOOK_URL=
WHATSAPP_WEBHOOK_TOKEN=
# مفتاح الدولة المستخدم لتحويل أرقام الجوال المحلية، دون علامة +
DEFAULT_COUNTRY_CODE=966

# --- التنبيهات اليومية (ساعة الخادم، 24) ---
DIGEST_HOUR=7

# --- بيانات الاختبار (تُستخدم مع: npm run seed -- --demo) ---
DEMO_PASSWORD=

